{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "group:monorepos",
    "group:recommended"
  ],
  "description": "Enterprise-grade Renovate config for Terragrunt/Terraform infrastructure",
  "dependencyDashboard": true,
  "prCreation": "not-pending",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track tool versions in GitHub Actions inputs",
      "managerFilePatterns": [
        "/^\\.github/actions/.+/action\\.yml$/"
      ],
      "matchStrings": [
        "default: '(?<currentValue>[^']*)'\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Track tool versions in Dockerfile ARGs",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "ARG\\s+(?:.*?)_VERSION=(?<currentValue>.*)\\s+# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?"
      ]
    },
    {
      "customType": "regex",
      "description": "Track iac-modules-repo release pins (module_versions maps in env.hcl). Tags look like <module>-vX.Y.Z",
      "managerFilePatterns": [
        "/(^|/)env\\.hcl$/"
      ],
      "matchStrings": [
        "(?<module>[a-z0-9_]+)\\s*=\\s*\"(?<prefix>[a-z0-9-]+)-v(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "ok-karthik/enterprise-aws-infrastructure",
      "depTypeTemplate": "{{{module}}}",
      "extractVersionTemplate": "^{{{prefix}}}-v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Track Terragrunt registry modules (tfr:// protocol)",
      "managerFilePatterns": [
        "/\\.hcl$/"
      ],
      "matchStrings": [
        "source\\s*=\\s*\"tfr://registry\\.terraform\\.io/(?<depName>[^/]+/[^/]+/[^/\\?]+)(?://.*?)?\\?version=(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "terraform-module"
    }
  ],
  "packageRules": [
    {
      "description": "discovery_publisher pin in dev: own PR, no automerge, so the promotion order is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["discovery_publisher"],
      "matchFileNames": ["**/workloads-dev/env.hcl"],
      "groupName": "iac-modules: discovery_publisher pin (dev)",
      "automerge": false,
      "addLabels": ["iac-modules", "dev"]
    },
    {
      "description": "discovery_publisher pin in prod: own PR, no automerge, so the promotion order is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["discovery_publisher"],
      "matchFileNames": ["**/workloads-prod/env.hcl"],
      "groupName": "iac-modules: discovery_publisher pin (prod)",
      "automerge": false,
      "addLabels": ["iac-modules", "prod"]
    },
    {
      "description": "account_baseline pin in management: own PR, no automerge, so the promotion order is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["account_baseline"],
      "matchFileNames": ["**/management/env.hcl"],
      "groupName": "iac-modules: account_baseline pin (management)",
      "automerge": false,
      "addLabels": ["iac-modules", "management"]
    },
    {
      "description": "account_baseline pin in dev: own PR, no automerge, so the promotion order is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["account_baseline"],
      "matchFileNames": ["**/workloads-dev/env.hcl"],
      "groupName": "iac-modules: account_baseline pin (dev)",
      "automerge": false,
      "addLabels": ["iac-modules", "dev"]
    },
    {
      "description": "account_baseline pin in prod: own PR, no automerge, so the promotion order is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["account_baseline"],
      "matchFileNames": ["**/workloads-prod/env.hcl"],
      "groupName": "iac-modules: account_baseline pin (prod)",
      "automerge": false,
      "addLabels": ["iac-modules", "prod"]
    },
    {
      "description": "vpc pin in dev: own PR, no automerge, so the promotion order dev then prod is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["vpc"],
      "matchFileNames": ["**/dev/env.hcl"],
      "groupName": "iac-modules: vpc pin (dev)",
      "automerge": false,
      "addLabels": ["iac-modules", "dev"]
    },
    {
      "description": "vpc pin in prod: own PR, no automerge, so the promotion order dev then prod is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["vpc"],
      "matchFileNames": ["**/prod/env.hcl"],
      "groupName": "iac-modules: vpc pin (prod)",
      "automerge": false,
      "addLabels": ["iac-modules", "prod"]
    },
    {
      "description": "eks pin in dev: own PR, no automerge, so the promotion order dev then prod is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["eks"],
      "matchFileNames": ["**/dev/env.hcl"],
      "groupName": "iac-modules: eks pin (dev)",
      "automerge": false,
      "addLabels": ["iac-modules", "dev"]
    },
    {
      "description": "eks pin in prod: own PR, no automerge, so the promotion order dev then prod is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["eks"],
      "matchFileNames": ["**/prod/env.hcl"],
      "groupName": "iac-modules: eks pin (prod)",
      "automerge": false,
      "addLabels": ["iac-modules", "prod"]
    },
    {
      "description": "organization pin in _global: own PR, no automerge, so the promotion order dev then prod is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["organization"],
      "matchFileNames": ["**/management/env.hcl"],
      "groupName": "iac-modules: organization pin (_global)",
      "automerge": false,
      "addLabels": ["iac-modules", "global"]
    },
    {
      "description": "account_factory pin in _global: own PR, no automerge, so the promotion order dev then prod is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["account_factory"],
      "matchFileNames": ["**/management/env.hcl"],
      "groupName": "iac-modules: account_factory pin (_global)",
      "automerge": false,
      "addLabels": ["iac-modules", "global"]
    },
    {
      "description": "bootstrap_stacksets pin in _global: own PR, no automerge, so the promotion order dev then prod is kept",
      "matchManagers": ["custom.regex"],
      "matchDepTypes": ["bootstrap_stacksets"],
      "matchFileNames": ["**/management/env.hcl"],
      "groupName": "iac-modules: bootstrap_stacksets pin (_global)",
      "automerge": false,
      "addLabels": ["iac-modules", "global"]
    },
    {
      "matchManagers": ["terraform", "terragrunt", "custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Infrastructure Dependencies (Non-Major)"
    },
    {
      "matchPackageNames": ["terraform-aws-modules/**"],
      "groupName": "AWS Official Modules"
    },
    {
      "matchPackageNames": ["hashicorp/terraform", "gruntwork-io/terragrunt"],
      "groupName": "Core IaC Tools"
    }
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["at any time"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0
}
